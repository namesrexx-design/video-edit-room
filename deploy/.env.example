# Copy to deploy/.env (never commit .env). Same file works on the PC (media-push) and on the server.
# Values come from Rexx's Cloudflare account. Docker does not expand ${...} inside this file, so fill every line.

# --- Cloudflare R2 (Cloudflare dashboard → R2 → Manage API tokens → Create API token → "Object Read & Write")
# The token page shows: Access Key ID, Secret Access Key, and the endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=lyfe-studio
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# --- The web page
# :80 until a domain points here; then e.g. studio.biz-box.io (HTTPS is automatic)
STUDIO_DOMAIN=:80
STUDIO_USER=rexx
# make with:  docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
STUDIO_PASSWORD_HASH=

# --- GitHub: fine-grained token, repository video-edit-room, Contents read/write (server pulls and pushes)
GITHUB_TOKEN=
