# HTTPS is automatic once STUDIO_DOMAIN points at this server (e.g. studio.biz-box.io).
# Until then STUDIO_DOMAIN=:80 serves plain http on the server's IP.
{$STUDIO_DOMAIN} {

	basic_auth {
		{$STUDIO_USER} {$STUDIO_PASSWORD_HASH}
	}

	encode gzip

	# /            → the storyboard page, straight from the repo (same files GitHub Pages serves)
	# /projects/*  → finished deliveries in the repo (film, scene clips, proxies, audio)
	# /media/*     → working media pulled from R2 (browsable)
	# /editor/*    → the page folder built on this server by build-board
	# the posting queue (2026-09-17)
	handle /scheduler* {
		reverse_proxy scheduler:8791
	}

	handle /api/* {
		reverse_proxy studio:8787
	}
	# the server builds its own board + sheets
	handle /board.json {
		root * /srv/editor
		file_server
	}
	handle /sheets/* {
		root * /srv/editor
		file_server
	}
	handle /projects/* {
		root * /srv/repo
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server browse
	}
	handle_path /editor/* {
		root * /srv/editor
		file_server
	}
	handle {
		root * /srv/repo/cut-room
		try_files {path} /storyboard-v2.html
		file_server
	}
}

# BizBox connector for members' AI agents. No basic auth: every request carries the member's workspace key,
# checked by the connector. No access log, because some apps put the key in the link.
{$CONNECTOR_DOMAIN:mcp.biz-box.io} {
	encode gzip

	# Agents hand over finished masters here (2026-09-17). This hostname resolves, studio.biz-box.io
	# does not yet, and an agent sandbox cannot reach port 22 at all — so HTTPS is the only door open
	# to them. Same password as the studio site. The studio API hashes the file on arrival and keeps
	# it only if the hash matches what the sender claimed.
	# Any agent can ask the machine what it actually has (2026-09-17). Read-only, same password.
	handle /state {
		basic_auth {
			{$STUDIO_USER} {$STUDIO_PASSWORD_HASH}
		}
		rewrite * /api/state
		reverse_proxy studio:8787
	}

	handle /upload* {
		basic_auth {
			{$STUDIO_USER} {$STUDIO_PASSWORD_HASH}
		}
		rewrite * /api{uri}
		reverse_proxy studio:8787
	}

	reverse_proxy connector:8790
}
