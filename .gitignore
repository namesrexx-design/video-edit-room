# media never enters git
*.mp4
*.mov
*.wav
*.mp3
*.aac
*.png
*.jpg
projects/*/renders/*.mp4
projects/*/renders/*.receipt.json
!projects/*/renders/RECEIPTS/*.json

# Cut Room saves (page-native JSON, format 2) are committed; renders are not
!projects/*/cuts/*.json

# thumbnail sheets are small enough to keep in git (one JPEG per group)
!cut-room/sheets/*.jpg

# finished scene deliveries (render + approved audio + receipt) ARE committed, so remote agents (Codex/Astra) can hand them in
!projects/*/deliveries/**
!projects/*/deliveries/**/*.mp4
!projects/*/deliveries/**/*.wav
!projects/*/deliveries/**/*.mp3
!projects/*/deliveries/**/*.png
!projects/*/deliveries/**/*.jpg

# local sync backups of the storyboard source (kept on disk, not in git)
projects/garage-dream/source/_backups/

# server secrets
deploy/.env

deploy/connector/node_modules/
