# media never enters git
*.mp4
*.mov
*.wav
*.mp3
*.aac
*.png
*.jpg
projects/*/renders/*.mp4
projects/*/renders/*.receipt.json
!projects/*/renders/RECEIPTS/*.json

# Cut Room saves (page-native JSON, format 2) are committed; renders are not
!projects/*/cuts/*.json

# thumbnail sheets are small enough to keep in git (one JPEG per group)
!cut-room/sheets/*.jpg
